{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://parklas.local/schemas/city-config.schema.json",
  "title": "City config",
  "description": "data/<city_id>/city.json. Holds the city's identity and time zone. The zoning category mapping is its own file (zoning-categories-config.schema.json).",
  "type": "object",
  "required": ["city_id", "name", "time_zone"],
  "additionalProperties": false,
  "properties": {
    "city_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "time_zone": { "type": "string", "minLength": 1, "description": "IANA time zone, e.g. America/Los_Angeles." }
  }
}
