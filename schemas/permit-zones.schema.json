{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://parklas.local/schemas/permit-zones.schema.json",
  "title": "Permit zone polygons",
  "description": "data/<city_id>/permit-zones.geojson. One polygon per section of the city, labelled with the permit code.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": { "type": "array", "items": { "$ref": "#/definitions/feature" } }
  },
  "definitions": {
    "position": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "number" } },
    "ring": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/position" } },
    "polygon": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/ring" } },
    "feature": {
      "type": "object",
      "required": ["type", "properties", "geometry"],
      "properties": {
        "type": { "const": "Feature" },
        "properties": {
          "type": "object",
          "required": ["permit_code", "name", "city_id"],
          "additionalProperties": false,
          "properties": {
            "permit_code": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "city_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
          }
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "coordinates"],
              "properties": { "type": { "const": "Polygon" }, "coordinates": { "$ref": "#/definitions/polygon" } }
            },
            {
              "type": "object",
              "required": ["type", "coordinates"],
              "properties": {
                "type": { "const": "MultiPolygon" },
                "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/polygon" } }
              }
            }
          ]
        }
      }
    }
  }
}
